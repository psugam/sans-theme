      <description>&lt;div class=&#34;custom-code-block-wrapper&#34; data-lang=&#34;python&#34;&gt;&#xD;&#xA;  &lt;div class=&#34;custom-code-toolbar&#34;&gt;&#xD;&#xA;    &lt;span class=&#34;code-lang-label&#34;&gt;PYTHON&lt;/span&gt;&#xD;&#xA;    &lt;button class=&#34;copy-code-btn&#34; onclick=&#34;copyCode(this)&#34;&gt;📋 Copy&lt;/button&gt;&#xD;&#xA;  &lt;/div&gt;&#xD;&#xA;  &lt;pre class=&#34;custom-code-block&#34;&gt;&lt;code class=&#34;language-python&#34;&gt;&#xD;&#xA;def greet(name):&#xD;&#xA;    print(f&amp;amp;#34;Hello, {name}!&amp;amp;#34;)&#xD;&#xA;&lt;/code&gt;&lt;/pre&gt;&#xD;&#xA;&lt;/div&gt;&#xD;&#xA;&#xD;&#xA;&lt;script&gt;&#xD;&#xA;function copyCode(btn) {&#xD;&#xA;  const code = btn.closest(&#39;.custom-code-block-wrapper&#39;).querySelector(&#39;code&#39;).innerText;&#xD;&#xA;  navigator.clipboard.writeText(code);&#xD;&#xA;  btn.textContent = &#39;✅ Copied&#39;;&#xD;&#xA;  setTimeout(() =&gt; btn.textContent = &#39;📋 Copy&#39;, 1500);&#xD;&#xA;}&#xD;&#xA;&lt;/script&gt;&#xD;&#xA;&#xA;&#xD;&#xA;&#xD;&#xA;&lt;div class=&#34;custom-code-block-wrapper&#34; data-lang=&#34;html&#34;&gt;&#xD;&#xA;  &lt;div class=&#34;custom-code-toolbar&#34;&gt;&#xD;&#xA;    &lt;span class=&#34;code-lang-label&#34;&gt;HTML&lt;/span&gt;&#xD;&#xA;    &lt;button class=&#34;copy-code-btn&#34; onclick=&#34;copyCode(this)&#34;&gt;📋 Copy&lt;/button&gt;&#xD;&#xA;  &lt;/div&gt;&#xD;&#xA;  &lt;pre class=&#34;custom-code-block&#34;&gt;&lt;code class=&#34;language-html&#34;&gt;&#xD;&#xA;&amp;amp;lt;div class=&amp;amp;#34;box&amp;amp;#34;&amp;amp;gt;Hello world&amp;amp;lt;/div&amp;amp;gt;&#xD;&#xA;&lt;/code&gt;&lt;/pre&gt;&#xD;&#xA;&lt;/div&gt;&#xD;&#xA;&#xD;&#xA;&lt;script&gt;&#xD;&#xA;function copyCode(btn) {&#xD;&#xA;  const code = btn.closest(&#39;.custom-code-block-wrapper&#39;).querySelector(&#39;code&#39;).innerText;&#xD;&#xA;  navigator.clipboard.writeText(code);&#xD;&#xA;  btn.textContent = &#39;✅ Copied&#39;;&#xD;&#xA;  setTimeout(() =&gt; btn.textContent = &#39;📋 Copy&#39;, 1500);&#xD;&#xA;}&#xD;&#xA;&lt;/script&gt;</description>
